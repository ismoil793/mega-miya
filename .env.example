# =============================================================================
# AI PROVIDER — bring your own LLM
# =============================================================================
# Hosted mode: require every GitHub account/company to configure its own key.
REQUIRE_BYOK=true
# Generate once with: openssl rand -base64 32
# Keep this stable and secret; losing it makes stored provider keys unreadable.
AI_API_CREDENTIAL_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# Deployment-level provider settings are a fallback for self-hosted/single-tenant
# installations when REQUIRE_BYOK=false.
# One of: openai | openai-compatible | anthropic | ollama
AI_PROVIDER=anthropic

# --- Anthropic / Claude (native) ---------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key
# claude-opus-4-8 (best), claude-sonnet-4-6 (balanced), claude-haiku-4-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI, or ANY OpenAI-compatible endpoint -------------------------------
# Use AI_PROVIDER=openai for OpenAI proper, or AI_PROVIDER=openai-compatible and
# set OPENAI_BASE_URL to point at vLLM, OpenRouter, Together, Groq, LM Studio,
# or your own self-hosted gateway.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama (local models) ---------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# --- Shared LLM tuning -------------------------------------------------------
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.2

# =============================================================================
# REVIEW BEHAVIOR
# =============================================================================
# Review every repository the GitHub App is installed on (no per-repo DB opt-in).
# Set to false to only review repos explicitly enabled from the dashboard.
REVIEW_ALL_REPOS=false

# Only post inline comments at/above this severity (low | medium | high | critical).
# Lower-severity notes still appear in the summary comment.
MIN_SEVERITY=low

# Safety caps for very large PRs.
REVIEW_MAX_FILES=40
REVIEW_MAX_DIFF_CHARS=60000
# Full changed-file reasoning context. Disabled until an administrator opts in.
REVIEW_INCLUDE_FULL_FILES=false
REVIEW_MAX_FULL_FILE_CHARS=30000
REVIEW_MAX_TOTAL_CONTEXT_CHARS=120000
REVIEW_CONTEXT_FETCH_CONCURRENCY=4
REVIEW_CONTEXT_FETCH_TIMEOUT_MS=10000
REVIEW_CONTEXT_CACHE_TTL_MS=60000
REVIEW_INCLUDE_SUPPORTING_CONTEXT=false
REVIEW_MAX_CONTEXT_FILES=12
REVIEW_MAX_CONTEXT_FILE_CHARS=20000
REVIEW_MAX_CALLER_SCAN_FILES=30
REVIEW_MAX_MISSING_PATCH_CHARS=20000
# Comma-separated globs to skip (defaults cover lockfiles / generated / vendored).
# REVIEW_EXCLUDE_GLOBS=**/package-lock.json,**/dist/**,**/*.min.js

# =============================================================================
# GITHUB APP (required to read PRs and post reviews)
# =============================================================================
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub OAuth (for the dashboard sign-in / per-repo opt-in UI)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# DATABASE (optional — used for the dashboard, review history, and per-repo
# opt-in. With REVIEW_ALL_REPOS=true the bot still reviews if the DB is absent.)
# =============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mega-miyya?retryWrites=true&w=majority

# =============================================================================
# APP / AUTH
# =============================================================================
# Optional invite-only onboarding. Defaults to false when omitted.
REQUIRE_ACCESS_CODE=false
JWT_SECRET=your_jwt_secret_key_here
NEXTAUTH_URL=http://localhost:3004
NEXTAUTH_SECRET=your_nextauth_secret
